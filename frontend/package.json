{
  "name": "@cineko/central-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.19.0",
    "npm": ">=12.0.2 <13"
  },
  "scripts": {
    "build": "vite build --config vite.central.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run storybook:build",
    "lint": "oxlint -D correctness -D suspicious -W perf -A react/react-in-jsx-scope --react-plugin --vitest-plugin src test --deny-warnings",
    "storybook": "storybook dev --host 0.0.0.0 --port 6010 --no-open",
    "storybook:build": "storybook build",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mantine/core": "9.5.1",
    "@tabler/icons-react": "3.46.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.5.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "30.0.1",
    "oxlint": "1.78.0",
    "pretendard": "1.3.9",
    "typescript": "7.0.2",
    "storybook": "10.5.8",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
